# ==============================================================================
# MODEL CONFIGURATION
# ==============================================================================
# Configure which LLM to use. Supports OpenAI, Anthropic, Google, Mistral, etc.
#
# Examples:
#   MODEL=gpt-4o                                    # OpenAI (default)
#   MODEL=litellm/anthropic/claude-sonnet-4-20250514 # Anthropic Claude
#   MODEL=litellm/gemini/gemini-2.0-flash           # Google Gemini
#   MODEL=litellm/mistral/mistral-large-latest      # Mistral
#   MODEL=litellm/deepseek/deepseek-chat            # DeepSeek

MODEL=gpt-4o

# ==============================================================================
# API KEYS (set the one matching your MODEL provider)
# ==============================================================================

# OpenAI
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Mistral
MISTRAL_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# ==============================================================================
# VOICE MODE (ElevenLabs TTS)
# ==============================================================================
ELEVENLABS_API_KEY=

# ==============================================================================
# NGROK (for MCP URL generation)
# ==============================================================================
NGROK_AUTH_TOKEN=

# ==============================================================================
# VERIS CORE (for observability/evaluation)
# ==============================================================================
VERIS_API_KEY=
